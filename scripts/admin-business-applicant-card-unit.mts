import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import { buildBusinessVerificationApplicant, formatApplicantWorkspaceTotal, type ApplicantWorkspace } from "../src/lib/admin/business-verification-applicant-model";
import { validateBusinessDecisionInput } from "../src/lib/admin/business-verification";
import { resolvePermissionsForRoles } from "../src/lib/auth/platform-permissions";
import type { PlatformAccessSnapshot } from "../src/lib/auth/platform-access";
const read = (p: string) => readFileSync(new URL(`../${p}`, import.meta.url), "utf8");
const access: PlatformAccessSnapshot = { userId: "staff", roles: ["admin"], permissions: resolvePermissionsForRoles(["admin"]), usedLegacyFallback: false };
const workspaces: ApplicantWorkspace[] = ["Ясень", "Берёза", "Альфа", "Липа"].map((name, i) => ({ id: `${i}`, name, slug: `author-${i}`, access_status: "free" }));
const input = { ownerUserId: "applicant", fullName: "  Иван Иванов  ", workspaces, sourceWorkspace: workspaces[0], rightsholder: { id: "holder", display_name: "Правообладатель", entity_type: "organization", status: "active" }, access };
const card = buildBusinessVerificationApplicant(input);
assert.equal(card.fullName, "Иван Иванов");
assert.equal(card.workspaces.length, 4);
assert.deepEqual(card.workspaces.map((w) => w.name), ["Альфа", "Берёза", "Липа", "Ясень"]);
assert.equal(card.workspaceTotal, "4 авторских проекта");
assert.equal(card.sourceWorkspace, workspaces[0]);
assert.equal(card.sourceLabel, "Ясень");
assert.equal(card.sourceWarning, null);
assert.equal(card.rightsholder, input.rightsholder);
assert.equal(card.profileHref, "/admin/users/applicant");
const missing = buildBusinessVerificationApplicant({ ...input, fullName: "  " });
assert.equal(missing.fullName, null);
assert.equal(missing.nameLabel, "Имя в профиле не заполнено – проверьте профиль");
assert.ok(!workspaces.some((w) => missing.nameLabel.includes(w.name)));
assert.equal(buildBusinessVerificationApplicant({ ...input, workspaces: [] }).workspaceTotal, "У аккаунта нет авторских проектов");
assert.equal(buildBusinessVerificationApplicant({ ...input, sourceWorkspace: { ...workspaces[0], id: "foreign" } }).sourceWarning, "пространство не принадлежит аккаунту заявителя – проверьте");
assert.equal(buildBusinessVerificationApplicant({ ...input, sourceWorkspace: null }).sourceLabel, "Не определено");
assert.equal(buildBusinessVerificationApplicant({ ...input, access: { ...access, roles: ["editor"], permissions: new Set() } }).profileHref, null);
for (const [n, text] of [[1, "1 авторский проект"], [2, "2 авторских проекта"], [5, "5 авторских проектов"], [11, "11 авторских проектов"], [14, "14 авторских проектов"], [21, "21 авторский проект"], [22, "22 авторских проекта"]] as const) assert.equal(formatApplicantWorkspaceTotal(n), text);
const valid = { action: "approve", reason: "", rightsholder: "00000000-0000-0000-0000-000000000001", newDisplayName: "", newEntityType: "", confirmScope: "yes" };
assert.equal(validateBusinessDecisionInput({ ...valid, action: "" }), "Выберите решение");
assert.equal(validateBusinessDecisionInput({ ...valid, action: "invalid" }), "Некорректное решение.");
assert.equal(validateBusinessDecisionInput({ ...valid, rightsholder: "" }), "Выберите правообладателя, которому присваивается подтверждение.");
assert.equal(validateBusinessDecisionInput({ ...valid, rightsholder: "invalid" }), "Некорректный правообладатель.");
const newHolder = { ...valid, rightsholder: "new", newDisplayName: "  Правообладатель  ", newEntityType: "person" };
for (const name of ["", "  ", "а".repeat(201)]) assert.equal(validateBusinessDecisionInput({ ...newHolder, newDisplayName: name }), "Укажите имя нового правообладателя (до 200 символов).");
for (const type of ["", "other"]) assert.equal(validateBusinessDecisionInput({ ...newHolder, newEntityType: type }), "Укажите тип правообладателя: физлицо или организация.");
assert.equal(validateBusinessDecisionInput({ ...valid, confirmScope: "" }), "Подтвердите правообладателя и охват решения галочкой.");
assert.equal(validateBusinessDecisionInput(valid), null);
assert.equal(validateBusinessDecisionInput(newHolder), null);
assert.equal(validateBusinessDecisionInput({ ...newHolder, newEntityType: "organization", newDisplayName: " а".trim().repeat(200) }), null);
assert.match(validateBusinessDecisionInput({ ...valid, action: "reject", reason: " " })!, /Укажите причину/);
assert.equal(validateBusinessDecisionInput({ ...valid, action: "reject", reason: "Причина", rightsholder: "", confirmScope: "" }), null);
const page = read("src/app/(platform)/admin/business-verification/page.tsx");
assert.equal((page.match(/authors!practices_author_id_fkey\(/g) ?? []).length, 2);
assert.doesNotMatch(page, /authors\(/);
assert.match(page, /snapshotHasPermission\(session.access, "users.view"\)/);
assert.match(page, /admin\/products\/\$\{c.product_id\}\/diagnostics/);
assert.doesNotMatch(page, /product\?\.title \?\? c.product_id/);
for (const heading of ["Заявитель / аккаунт", "Авторские проекты аккаунта", "Исходное пространство заявки", "Образец трека и доказательства", "Правообладатель, которому присваивается подтверждение", "Охват решения"]) assert.ok(page.includes(heading));
const fields = read("src/app/(platform)/admin/business-verification/BusinessDecisionFields.tsx");
assert.match(fields, /useState<string>\(""\)/);
assert.match(fields, /<option value="">Выберите решение<\/option>/);
assert.match(fields, /<option value="">Выберите правообладателя<\/option>/);
assert.match(fields, /<option value="">Выберите тип<\/option>/);
assert.match(fields, /action === "approve"/);
assert.match(fields, /binding === "new"/);
assert.match(fields, /name="confirmScope" value="yes" required/);
assert.match(fields, /aria-live="polite"/);
assert.match(fields, /setConfirmed\(false\)/);
const loader = read("src/lib/admin/business-verification-applicant.ts");
assert.match(loader, /import "server-only"/);
assert.ok(loader.indexOf('await requireAdminPermission("author_products.moderate")') < loader.indexOf("const service = createServiceRoleClient"));
assert.match(loader, /select\("id, full_name"\)/);
assert.doesNotMatch(loader, /email|phone|inn/i);
assert.match(loader, /\.eq\("role", "owner"\)/);
assert.match(loader, /business_rightsholder_accounts/);
for (const file of ["src/lib/admin/business-verification.ts", "src/lib/admin/business-verification-applicant.ts", "src/lib/admin/business-verification-applicant-model.ts", "src/lib/admin/nav-attention.ts", "src/lib/admin/nav-attention-cache.ts", "src/app/(platform)/admin/layout.tsx", ...["author-applications", "commercial-applications", "payout-profiles", "product-moderation", "business-verification"].map((q) => `src/app/(platform)/admin/${q}/actions.ts`), "src/lib/classica/production/actions.ts", "src/app/(platform)/admin/business-verification/page.tsx", "src/app/(platform)/admin/business-verification/BusinessDecisionFields.tsx"]) assert.doesNotMatch(read(file), /\u2014/, file);
console.log("admin-business-applicant-card-unit: OK");
