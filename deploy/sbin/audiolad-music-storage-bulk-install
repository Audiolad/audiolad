#!/bin/bash
# Intended install: /usr/local/sbin/audiolad-music-storage-bulk-install
set -Eeuo pipefail
if [[ $# -ne 0 ]]; then
  printf 'ERROR: accepts no arguments.\n' >&2
  exit 1
fi
PATH=/usr/sbin:/usr/bin:/bin
export PATH
LIB_ROOT_INSTALL=/usr/local/lib/audiolad/audiolad-music-storage-bulk-root-install.sh
if [[ ! -x "$LIB_ROOT_INSTALL" ]]; then
  printf 'ERROR: pinned root install missing; run production DEPLOY or bootstrap.\n' >&2
  exit 1
fi
exec "$LIB_ROOT_INSTALL"