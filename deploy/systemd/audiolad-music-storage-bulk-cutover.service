[Unit]
Description=Audiolad music masters bulk migration (cutover stage, one batch)
Documentation=file:/var/www/audiolad/deploy/docs/runbooks/music-masters-bulk-orchestrator.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/audiolad/music-storage-bulk-cutover.env
ExecStart=/usr/local/lib/audiolad/audiolad-music-storage-bulk-orchestrator.sh cutover tick
Nice=10
SyslogIdentifier=audiolad-music-storage-bulk-cutover
StandardOutput=journal
StandardError=journal