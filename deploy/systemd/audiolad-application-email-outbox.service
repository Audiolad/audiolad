[Unit]
Description=Audiolad application email outbox worker
Documentation=file:/var/www/audiolad/deploy/docs/APPLICATION_EMAIL_OUTBOX.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/audiolad/run-application-email-outbox.sh
Environment=DEPLOY_ROOT=/var/www/audiolad-deploy
Environment=LOCK_FILE=/run/audiolad-application-email-outbox.lock
Environment=LOG_FILE=/var/log/audiolad/application-email-outbox.log
Environment=TIMEOUT_SECONDS=90
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Hard cap above the wrapper timeout so a hung npm cannot linger past the lease.
TimeoutStartSec=120
SyslogIdentifier=audiolad-application-email-outbox
StandardOutput=journal
StandardError=journal
