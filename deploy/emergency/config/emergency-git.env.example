# Example only. Copy to /etc/audiolad/emergency-git.env on the production
# host during a later, explicit install. Do not put real tokens here.
# Mode 0600, owner root. This file is not read by the primary GitHub path.
EMERGENCY_MIRROR_URL=ssh://git@203.0.113.10:2222/Audiolad/audiolad.git
GITHUB_ORIGIN_URL=git@github-audiolad:Audiolad/audiolad.git
GIT_WORKDIR=/var/www/audiolad-clean
DEPLOY_ROOT=/var/www/audiolad-deploy
AUDIT_LOG=/var/log/audiolad/emergency-git-source.log
STATE_DIR=/var/lib/audiolad/emergency
ALLOW_FILE_MIRROR=0
ALLOW_HTTP_MIRROR=0
