# Example only. Lives on the future Gitea host, not in git with real values.
# Mode 0600, owner root. sync-from-github.sh reads these names from the
# environment. Do not commit the filled file.
EMERGENCY_MIRROR_ROOT=/var/lib/audiolad/emergency/mirrors
EMERGENCY_STATE_DIR=/var/lib/audiolad/emergency/state
EMERGENCY_MIRROR_BASE=ssh://git@127.0.0.1:2222
EMERGENCY_GITHUB_BASE=https://github.com
EMERGENCY_MIRROR_BACKEND=gitea
GITEA_BASE_URL=http://127.0.0.1:3000
GITEA_USERNAME=audiolad-mirror
GITEA_TOKEN=replace-with-local-token
ALLOW_FILE_MIRROR=0
ALLOW_HTTP_MIRROR=0
