# Draft only. Do NOT install from CI or from OPS_MAINTENANCE_DRY_RUN.
# Narrow sudoers fragment for the production deploy user.
# No unrestricted ALL sudo. No wildcards. No arbitrary paths or shell.
# Empty argument list ("") locks zero arguments under standard sudoers
# semantics (command with no argv). The shell wrapper also rejects argc!=0.
# Allows exactly: sudo -n /usr/local/sbin/audiolad-maintenance-dry-run
deploy ALL=(root) NOPASSWD: /usr/local/sbin/audiolad-maintenance-dry-run ""
