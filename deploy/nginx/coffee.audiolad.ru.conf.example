# EXAMPLE ONLY. Sergey must approve DNS, certificate issuance and nginx changes.
# Same upstream as business; verify the existing upstream before using this file.
# Enable the 443 block only after issuing the certificate via the existing ACME process.
server {
    listen 80;
    server_name coffee.audiolad.ru;
    # Preserve the existing ACME HTTP challenge location here if required.
    location / { return 308 https://coffee.audiolad.ru$request_uri; }
}
server {
    listen 443 ssl;
    server_name coffee.audiolad.ru;
    ssl_certificate /etc/letsencrypt/live/coffee.audiolad.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coffee.audiolad.ru/privkey.pem;
    client_max_body_size 55m;
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Host coffee.audiolad.ru;
        proxy_set_header X-Forwarded-Host coffee.audiolad.ru;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
